# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/

# 運行時狀態（一律不入 git）
state/

# skills CLI 安裝產物（第三方內容，由 bootstrap 重建；lock 檔記錄了它們的來源）
skills/core/
skills/pool/
skills-lock.json

# 本地自製 skill 屬於運行時使用者內容：預設不入 git。
# 若想把自己的 skills 版本化，刪掉下面兩行即可。
skills/local-made/*
!skills/local-made/.gitkeep

# 研究暫存
_research/
